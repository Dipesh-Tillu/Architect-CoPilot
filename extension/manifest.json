{
  "manifest_version": 3,
  "name": "Architect Copilot (Side Panel) \u2014 Upgraded",
  "version": "0.2.0",
  "description": "Context-aware GenAI helper with grounding, redaction, and memory.",
  "action": {
    "default_title": "Architect Copilot"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
	"windows",
	"system.display"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html"
}