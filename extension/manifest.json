{
  "manifest_version": 3,
  "name": "Architect Copilot — No Backend",
  "version": "0.3.0",
  "description": "Context-aware GenAI copilot in the browser side panel.",
  "action": { "default_title": "Architect Copilot" },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "windows"],
  "host_permissions": ["https://api.openai.com/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
